{
  "name": "newman",
  "version": "1.0.0",
  "description": "Personal pi extension — Schwab market data, browser fetch/search, and Hacker News tools",
  "keywords": [
    "pi-package"
  ],
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2"
  },
  "scripts": {
    "newman": "node node_modules/.bin/pi --extension ./index.ts",
    "build": "esbuild index.ts --bundle --platform=node --format=esm --outfile=dist/newman.js --external:@earendil-works/pi-coding-agent --external:typebox --external:node:net --external:node:fs --external:node:os --external:node:path --external:node:buffer"
  }
}
